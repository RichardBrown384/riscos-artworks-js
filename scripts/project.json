{
  "name": "scripts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "root": "scripts",
  "projectType": "application",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"scripts/**/*.mts\"",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^typecheck"],
      "options": {
        "command": "tsc -p scripts/tsconfig.json",
        "cwd": "."
      }
    }
  }
}
